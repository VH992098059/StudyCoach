# VOICE_MODEL=FunAudioLLM/CosyVoice2-0.5B
# VOICE_NAME=FunAudioLLM/CosyVoice2-0.5B:alex
# VOICE_SPEED=1.0
# VOICE_FORMAT=mp3
# ASR_URL=http://localhost:50000

# ---------- 基础设施地址（可选） ----------
# SEAWEEDFS_FILER=http://10.0.0.153:8888
# VECTOR_ENGINE=milvus
# ES_ADDRESS=http://localhost:19200
# ES_INDEX_NAME=study
# MILVUS_ADDRESS=10.0.0.153:19530
