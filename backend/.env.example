# ============================================================
# studyCoach 后端 .env 模板
# 用法：复制为 backend/.env 并填入真实值（.env 已被 .gitignore 忽略，不会上传）。
# 启动时 main.go 会根据 .env 渲染 manifest/config/config.template.yaml，
# 自动生成 manifest/config/config.yaml；模板中带默认值的项可不填。
# 未注释的为必填项；注释掉的为可选项（等号后即当前默认值）。
# 注意：进程环境变量优先于 .env 中的同名值（便于 CI/容器注入）。
# ============================================================

# ---------- 数据库（gorm 数据迁移用，格式同 postgres DSN；host 建议写 127.0.0.1 避免 IPv6 超时） ----------
DB_PGSQL='host=127.0.0.1 user=postgres password=123456 dbname=studyCoach port=5656 sslmode=disable TimeZone=Asia/Shanghai'
# ---------- 数据库（gf gdb 连接串，格式：pgsql:用户:密码@tcp(主机:端口)/库名） ----------
DATABASE_LINK=pgsql:postgres:123456@tcp(127.0.0.1:5656)/studyCoach

# ---------- Redis ----------
REDIS_PASS=123456
# REDIS_ADDRESS=localhost:6379

# ---------- 模型密钥（每段独立，对应 config.yaml 同名段） ----------
# 火山方舟 ark 平台 key（Branch / Analysis / embeddingArk / rewrite / ark / cron 各段独立填写）
BRANCH_API_KEY=
ANALYSIS_API_KEY=
EMBEDDING_ARK_API_KEY=
REWRITE_API_KEY=
ARK_API_KEY=
CRON_API_KEY=
# SiliconFlow 平台 key（embedding / qa / rerank / siliconflow 各段独立填写）
EMBEDDING_API_KEY=
QA_API_KEY=
RERANK_API_KEY=
SILICONFLOW_API_KEY=
# 语音合成 key（可留空表示不启用）
VOICE_API_KEY=

# ---------- 模型与地址（可选，不填用模板默认值；改模型只需取消注释） ----------
# BRANCH_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# BRANCH_MODEL=doubao-seed-2-0-lite-260215
# ANALYSIS_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ANALYSIS_MODEL=doubao-seed-2-0-lite-260215
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_ARK_MODEL=doubao-embedding-vision-251215
# REWRITE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# REWRITE_MODEL=doubao-1-5-pro-32k-character-250715
# QA_BASE_URL=https://api.siliconflow.cn/v1
# QA_MODEL=zai-org/GLM-4.6V
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-2-0-pro-260215
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
